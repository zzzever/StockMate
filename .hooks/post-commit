#!/usr/bin/env bash
# post-commit hook — auto-build frontend + backend after every commit
# Run: copy to .git/hooks/post-commit and chmod +x

echo ""
echo "═══════════════════════════════════════════════════"
echo "  post-commit: 构建前后端..."
echo "═══════════════════════════════════════════════════"

PROJECT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# Step 1: Frontend
echo "→ 前端 npm run build..."
cd "$PROJECT_DIR/ui" || { echo "  前端目录不存在，跳过"; exit 0; }
if npm run build 2>&1 | tail -2; then
    echo "  前端构建完成 ✓"
else
    echo "  前端构建失败 ❌"
    exit 1
fi

# Step 2: Backend
echo "→ 后端 cargo build --release..."
cd "$PROJECT_DIR" || exit 0
CARGO="$HOME/.cargo/bin/cargo"
if [ -f "$CARGO" ]; then
    # Kill any running instance before building
    if command -v taskkill &> /dev/null; then
        taskkill //F //IM stockmate-tauri.exe //IM stockmate.exe 2>/dev/null || true
    fi
    if "$CARGO" build --release 2>&1 | tail -3; then
        echo "  后端构建完成 ✓"
    else
        echo "  后端构建失败 ❌"
        exit 1
    fi
else
    echo "  cargo 未找到，跳过后端构建"
fi

echo "═══════════════════════════════════════════════════"
echo "  构建完成，请重启 app"
echo "═══════════════════════════════════════════════════"
