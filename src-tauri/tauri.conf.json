{
  "build": {
    "beforeDevCommand": "cd ui && pnpm dev",
    "beforeBuildCommand": "cd ui && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "shortDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": []
    },
    "resources": [],
    "fileAssociations": []
  },
  "productName": "StockMate",
  "identifier": "com.stockmate.app",
  "version": "0.1.0",
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420; img-src 'self' data:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "StockMate",
        "width": 1280,
        "minWidth": 1024,
        "minHeight": 640
      }
    ]
  }
}
