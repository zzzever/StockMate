{
  "build": {
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "copyright": "",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "shortDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": []
    },
    "resources": [],
    "fileAssociations": []
  },
  "productName": "StockMate",
  "identifier": "com.stockmate.app",
  "version": "0.1.0",
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:15678 https://web.ifzq.gtimg.cn https://qt.gtimg.cn http://ifzq.gtimg.cn"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "StockMate",
        "theme": "Light",
        "decorations": false,
        "devtools": true,
        "width": 1280,
        "minWidth": 1024,
        "minHeight": 640
      }
    ]
  }
}
